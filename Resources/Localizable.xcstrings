    "service.install.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChargeLmt needs a root background service to read battery status and write SMC charging thresholds. It registers chargelmtd as a system LaunchDaemon. macOS may ask you to approve it or enter an administrator password.\n\nYou can remove the background service later in Settings."
          }
        }
      }
    },
    "service.uninstall.explanation" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This stops chargelmtd, restores macOS charging behavior, and deletes the installed daemon. macOS may ask you to approve the change or enter an administrator password.\n\nRun this before deleting ChargeLmt.app; macOS does not provide a callback when an app is deleted."
          }
        }
      }
    },
    "一次性操作" : {
